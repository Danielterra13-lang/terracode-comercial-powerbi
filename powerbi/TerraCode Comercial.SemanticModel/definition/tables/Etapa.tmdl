table Etapa
	lineageTag: 8fcc52eb-9db0-4b09-9eb8-8ca98f0decef

	column id_etapa
		dataType: int64
		isHidden
		lineageTag: d8419b4f-6b30-47e5-8992-7ce8a226ad7b
		summarizeBy: none
		sourceColumn: id_etapa

	column id_pipeline
		dataType: int64
		isHidden
		lineageTag: e752cbab-7790-4338-a5b2-615386806912
		summarizeBy: none
		sourceColumn: id_pipeline

	column Etapa
		dataType: string
		lineageTag: 84e4dedf-1b4a-480b-aefc-ddb864cca04d
		summarizeBy: none
		sourceColumn: etapa

	column 'Ordem da etapa'
		dataType: int64
		isHidden
		lineageTag: f0343270-88d6-4994-9ce6-fab1284af23e
		summarizeBy: none
		sourceColumn: ordem_etapa

	column 'Status da etapa'
		dataType: string
		lineageTag: 1f6165af-ef0e-49fd-a434-438d613fa615
		summarizeBy: none
		sourceColumn: status

	column 'Fase do funil'
		dataType: string
		lineageTag: f008f5b6-690e-480a-a34f-1fb6d10e4fe5
		summarizeBy: none
		sourceColumn: fase_funil

	partition Etapa = m
		mode: import
		source =
				let
				    Origem = Csv.Document(File.Contents(PastaDados & "dim_etapa.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Origem, [PromoteAllScalars=true]),
				    Nulos = Table.ReplaceValue(Cabecalhos, "", null, Replacer.ReplaceValue, Table.ColumnNames(Cabecalhos)),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"id_etapa", Int64.Type}, {"id_pipeline", Int64.Type}, {"etapa", type text}, {"ordem_etapa", Int64.Type}, {"status", type text}, {"fase_funil", type text}}, "en-US")
				in
				    Tipos

