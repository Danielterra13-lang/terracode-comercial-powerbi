table Metas
	lineageTag: e8907a43-92be-401c-8b5c-feb98e2a4069

	column inicio_mes
		dataType: dateTime
		isHidden
		formatString: dd/mm/yyyy
		lineageTag: 1ccb69fe-8342-4668-b047-f626e9bab004
		summarizeBy: none
		sourceColumn: inicio_mes

		annotation UnderlyingDateTimeDataType = Date

	column id_vendedor
		dataType: int64
		isHidden
		lineageTag: f08226ef-f787-4d34-b59f-b5ba90271e5e
		summarizeBy: none
		sourceColumn: id_vendedor

	column id_pipeline
		dataType: int64
		isHidden
		lineageTag: af8391ba-699a-4965-9f9e-77f593d25b0a
		summarizeBy: none
		sourceColumn: id_pipeline

	column 'Meta (valor)'
		dataType: double
		isHidden
		formatString: \R\$ #,0
		lineageTag: 92023e62-a85a-4400-a9fc-984b6f2f9243
		summarizeBy: none
		sourceColumn: meta

	partition Metas = m
		mode: import
		source =
				let
				    Origem = Csv.Document(File.Contents(PastaDados & "fato_metas.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Origem, [PromoteAllScalars=true]),
				    Nulos = Table.ReplaceValue(Cabecalhos, "", null, Replacer.ReplaceValue, Table.ColumnNames(Cabecalhos)),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"inicio_mes", type date}, {"id_vendedor", Int64.Type}, {"id_pipeline", Int64.Type}, {"meta", type number}}, "en-US")
				in
				    Tipos

