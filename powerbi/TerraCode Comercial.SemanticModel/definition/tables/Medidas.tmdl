	measure 'Cor var dia anterior' = IF(ISBLANK([Receita dia anterior]), "#8A8A8A", IF([Var. receita vs dia anterior] >= 0, "#2E7D5B", "#C8553D"))
		displayFolder: 10. Visuais especiais
		lineageTag: 53e7aeb5-66f9-4566-8939-48bff0a15736

	measure 'Período (texto)' =
			VAR _ini = MIN(Calendario[Data])
			VAR _fim = MAX(Calendario[Data])
			RETURN
			    SWITCH(
			        TRUE(),
			        _ini = _fim, FORMAT(_ini, "dd/mm/yyyy") & " (" & FORMAT(_ini, "dddd") & ")",
			        FORMAT(_ini, "yyyymm") = FORMAT(_fim, "yyyymm"), FORMAT(_ini, "mmmm \d\e yyyy"),
			        FORMAT(_ini, "dd/mm/yy") & " a " & FORMAT(_fim, "dd/mm/yy")
			    )
		displayFolder: 10. Visuais especiais
		lineageTag: db070868-e960-4902-a93a-933c0d008283

	/// Número do dia + receita, para a matriz de calendário.
	measure 'Calendário célula' =
			VAR _dia = SELECTEDVALUE(Calendario[Dia])
			VAR _v = [Receita]
			RETURN
			    IF(
			        NOT ISBLANK(_dia),
			        _dia & UNICHAR(10) & IF(ISBLANK(_v), "-", "R$ " & FORMAT(_v / 1000, "#,0.0") & " mil")
			    )
		displayFolder: 10. Visuais especiais
		lineageTag: d7538edc-9954-4c3d-80cb-cdd85a125a9b

	measure 'Rótulo receita' =
			VAR _v = [Receita]
			RETURN
			    IF(
			        _v >= 1000000,
			        "R$ " & FORMAT(_v / 1000000, "#,0.00") & " mi",
			        "R$ " & FORMAT(_v / 1000, "#,0") & " mil"
			    )
		displayFolder: 10. Visuais especiais
		lineageTag: 4c6aa302-9ba7-4e50-888a-27afe47fd35e

	measure 'Rótulo % perdas' = FORMAT([% das perdas], "0.0%")
		displayFolder: 10. Visuais especiais
		lineageTag: 80a3ee16-75c1-4cab-9d4c-fcfc545be31c

	measure 'Rótulo conversão' = FORMAT([Conversão da coorte], "0.0%")
		displayFolder: 10. Visuais especiais
		lineageTag: 98efcab8-90bc-48a0-8b3a-cb2b03b76544

	/// Velocímetro de meta em SVG, escrito do zero. Exibido como imagem num cartão.
	measure 'SVG meta' =
			VAR _p = [% da meta]
			VAR _cor =
			    IF(_p >= 1, "%232E7D5B", IF(_p >= 0.8, "%23D9A441", "%23C8553D"))
			VAR _n = 60
			VAR _ativos = ROUND(MIN(_p, 1) * _n, 0)
			VAR _marcas =
			    CONCATENATEX(
			        GENERATESERIES(0, _n - 1, 1),
			        "<rect x='98' y='6' width='4' height='" & IF(MOD([Value], 5) = 0, 18, 11)
			            & "' rx='2' fill='" & IF([Value] < _ativos, _cor, "%23E4E1D8")
			            & "' transform='rotate(" & [Value] * 6 & " 100 100)'/>",
			        ""
			    )
			RETURN
			    IF(
			        NOT ISBLANK(_p),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'>"
			            & _marcas
			            & "<text x='100' y='110' text-anchor='middle' font-family='Bahnschrift, Segoe UI' font-size='38' font-weight='600' fill='%231A1A1A'>"
			            & FORMAT(_p * 100, "0") & "%25</text>"
			            & "<text x='100' y='136' text-anchor='middle' font-family='Segoe UI' font-size='13' fill='%236B6B6B'>da meta</text></svg>"
			    )
		displayFolder: 10. Visuais especiais
		lineageTag: 9aabd8dc-a524-444d-8547-965beb0e2b82
		dataCategory: ImageUrl

	/// Colunas do comparativo. Use com 'Comparativo'[Período] no eixo.
	measure 'Cmp mês valor' = SWITCH(SELECTEDVALUE('Comparativo'[Ordem]), 1, [Receita mês anterior], 3, [Receita])
		formatString: \R\$ #,0
		displayFolder: 10. Visuais especiais
		lineageTag: e413f96e-ca22-45fa-b64c-e526846764c6

	/// Linha horizontal acima das colunas.
	measure 'Cmp mês linha' =
			VAR _m = MAX([Receita mês anterior], [Receita])
			RETURN
			    IF(_m > 0, _m * 1.35)
		formatString: \R\$ #,0
		displayFolder: 10. Visuais especiais
		lineageTag: c3e110e1-a358-402e-a46d-dc34daa20930

	/// Fim do eixo Y, para sobrar espaço para a linha e o rótulo.
	measure 'Cmp mês eixo' = MAX([Receita mês anterior], [Receita]) * 1.6
