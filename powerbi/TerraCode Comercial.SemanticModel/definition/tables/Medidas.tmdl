		displayFolder: 10. Visuais especiais
		lineageTag: 91e2ae2e-a6d2-4208-aafc-047da4209bf1

	/// Ponto no meio da linha; o rótulo mostra a variação (format string dinâmica).
	measure 'Cmp mês variação' = IF(SELECTEDVALUE('Comparativo'[Ordem]) = 2 && NOT ISBLANK([Receita mês anterior]), [Cmp mês linha])
