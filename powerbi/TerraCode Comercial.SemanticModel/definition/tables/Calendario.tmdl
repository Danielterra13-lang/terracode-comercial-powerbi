	partition Calendario = m
		mode: import
		source =
				let
				    Origem = Csv.Document(File.Contents(PastaDados & "dim_calendario.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Origem, [PromoteAllScalars=true]),
				    Nulos = Table.ReplaceValue(Cabecalhos, "", null, Replacer.ReplaceValue, Table.ColumnNames(Cabecalhos)),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"data", type date}, {"ano", Int64.Type}, {"mes", Int64.Type}, {"nome_mes", type text}, {"mes_abrev", type text}, {"ano_mes", type text}, {"inicio_mes", type date}, {"trimestre", type text}, {"semana_iso", Int64.Type}, {"dia", Int64.Type}, {"dia_semana_num", Int64.Type}, {"dia_semana", type text}, {"dia_semana_abrev", type text}, {"semana_mes", Int64.Type}, {"feriado", type logical}, {"dia_util", type logical}}, "en-US"),
				    Rotulo = Table.AddColumn(Tipos, "mes_ano", each [mes_abrev] & "/" & Text.End(Text.From([ano]), 2), type text)
				  in
				    Rotulo

