{
  "name": "TerraCode Editorial",
  "dataColors": [
    "#1F6F78",
    "#D9A441",
    "#4C6A92",
    "#C8553D",
    "#7A9E7E",
    "#8C6E9C",
    "#B5A88F",
    "#5F7470"
  ],
  "background": "#FFFFFF",
  "foreground": "#1A1A1A",
  "tableAccent": "#1F6F78",
  "good": "#2E7D5B",
  "neutral": "#D9A441",
  "bad": "#C8553D",
  "maximum": "#1F6F78",
  "center": "#9CC3C6",
  "minimum": "#F1EFE8",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Bahnschrift, 'Segoe UI Semibold', sans-serif",
      "color": "#1A1A1A"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Bahnschrift, 'Segoe UI Semibold', sans-serif",
      "color": "#1A1A1A"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1A1A1A"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#6B6B6B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 12,
            "left": 14,
            "right": 14
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Bahnschrift, 'Segoe UI Semibold', sans-serif",
            "fontSize": 13,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#1A1A1A"
              }
            }
          }
        ],
        "subTitle": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#6B6B6B"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#ECEAE4"
              }
            },
            "gridlineStyle": "dotted",
            "labelColor": {
              "solid": {
                "color": "#8A8A8A"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "showAxisTitle": false
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#8A8A8A"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "legend": [
          {
            "position": "TopLeft",
            "labelColor": {
              "solid": {
                "color": "#6B6B6B"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#4A4A4A"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F4EF"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F5F4EF"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1A1A1A"
              }
            },
            "fontFamily": "Segoe UI",
            "textSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontalColor": {
              "solid": {
                "color": "#ECEAE4"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#6B6B6B"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    }
  }
}